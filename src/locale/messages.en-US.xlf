        <target>From quote to payment, all from your phone or computer. No paperwork.</target>
      </trans-unit>
      <trans-unit id="home.value.claims.title" datatype="html">
        <source>Siniestro automático</source>
        <target>Automatic claims</target>
      </trans-unit>
      <trans-unit id="home.value.claims.text" datatype="html">
        <source>Eventos paramétricos procesados automáticamente. Recibe tu indemnización sin trámites.</source>
        <target>Parametric events are processed automatically. Receive your compensation with no red tape.</target>
      </trans-unit>
